# Environment Configuration for VALUE.NET

# Server Configuration
PORT=3000
NODE_ENV=development

# Root Owner Initial Admin Credentials
ROOT_OWNER_EMAIL=owner@valuenet.gg
ROOT_OWNER_PASSWORD=RootOwner123!

# Supabase Credentials (Required for Production)
# Public Client Variables (VITE_ prefix required for Vite frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Private Server-Only Key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Gemini API Key
GEMINI_API_KEY=
